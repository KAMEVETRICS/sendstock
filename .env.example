# Copy to .env and fill in. Never commit .env.

# From @BotFather (/newbot). Also in BotFather: /setprivacy -> Disable (so @username tips resolve),
# and /newapp with short name "app" once the Mini App has an HTTPS URL.
TELEGRAM_BOT_TOKEN=
MINI_APP_SHORT_NAME=app

# Local dev only, for networks whose DNS blocks binance.com. Leave empty on the VPS.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Privy (dashboard.privy.io → your app → Settings). The app ID is public and ends up in the
# Mini App's browser bundle; the client ID is optional (App clients tab). Enable Telegram as a
# login method and set embedded wallets to "create on login" for users without one.
VITE_PRIVY_APP_ID=
VITE_PRIVY_CLIENT_ID=

DB_PATH=stocktip.db
API_PORT=8787
MIN_TIP_USD=1
MAX_TIP_USD=50
PAY_WINDOW_MINUTES=30

# Mini App API. Stays off until ESCROW_ADDRESS is set.
RPC_URL=https://bsc-dataseed.bnbchain.org
ESCROW_ADDRESS=
# agentic-wallet: claims go through `baw contract-call` (Developer Mode on in the Binance App).
# private-key: plain wallet, for local testing only.
OPERATOR=agentic-wallet
OPERATOR_ADDRESS=
OPERATOR_PRIVATE_KEY=
# Comma-separated origins allowed to call the API in dev, e.g. the Vite dev server.
CORS_ORIGINS=

# Contract deploys (hardhat). Fresh wallet with a few dollars of BNB only.
DEPLOYER_PRIVATE_KEY=
